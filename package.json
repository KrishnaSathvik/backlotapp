{
  "name": "backlot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/db/*.test.ts src/lib/*.test.ts src/lib/slate/*.test.ts src/lib/storage/*.test.ts src/lib/account/*.test.ts",
    "test:pg": "node --test src/lib/slate/shared-limits.test.ts",
    "bench:search": "node src/lib/slate/search-bench.run.ts",
    "db:push": "drizzle-kit push --config src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "restore:reapply-deletions": "node scripts/reapply-deletions-after-restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@google-cloud/storage": "8.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "boring-avatars": "^2.0.4",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "11.3.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "next": "^15.4.9",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  }
}
