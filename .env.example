# --- Gemini (Studio AI) ---
# Required for the Studio AI tab. AI Studio injects this from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional. Defaults to gemini-4-hydrogen.
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: where the app is hosted (AI Studio injects the Cloud Run URL).
APP_URL="MY_APP_URL"

# --- Postgres (required when signed in) ---
SQL_HOST="127.0.0.1"
SQL_DB_NAME="content_vault"
# App runtime user
SQL_USER="content_vault"
SQL_PASSWORD="change-me"
# Admin user, used only by `npm run db:push` to create/alter tables
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change-me"
