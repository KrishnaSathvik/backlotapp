# Backlot environment template. Copy to .env.local for development. In production set these in
# Vercel → Project → Settings → Environment Variables (Production, and Preview where noted).
# Full inventory with scopes: docs/DEPLOYMENT.md "Environment variables". Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret in one.

# --- Site ---
# Canonical https origin, no path (canonical URLs, sitemap, robots.txt, OG images, llms.txt).
# SITE_URL="https://backlot.example"
# Shown on /privacy, /terms and /support. Required in production.
# PRIVACY_CONTACT_EMAIL=""
# robots.txt asks model-training crawlers not to crawl (default on); "false" opts back in.
# ROBOTS_DISALLOW_AI_TRAINING="true"

# --- Database: Supabase Postgres (production) or local Postgres (development) ---
# Runtime: the Supabase TRANSACTION pooler, port 6543 (Project → Connect → Transaction pooler),
# as the limited backlot_app role from ops/supabase/roles.sql (never postgres at runtime).
# DATABASE_URL="postgresql://backlot_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations/operator scripts only (npm run db:migrate): SESSION pooler (5432) or direct connection.
# Not needed by the running app; keep it out of Vercel unless a script runs there.
# DATABASE_MIGRATION_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Supabase's CA certificate (PEM; Database → Settings → SSL configuration) for verified TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# "no-verify" encrypts without verifying (warned); "off" only for a local database.
# DATABASE_SSL=""
# Pool tuning (defaults: 5 connections per instance on Vercel, 10 locally).
# DB_POOL_MAX="5"
#
# Local development alternative to DATABASE_URL:
SQL_HOST="127.0.0.1"
SQL_DB_NAME="content_vault"
SQL_USER="content_vault"
SQL_PASSWORD="change-me"
# Used only by db:push / db:migrate against the local database.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change-me"

# --- Media storage: private Cloudflare R2 bucket (production) ---
# STORAGE_BACKEND="r2"          # unset = local .uploads (development only)
# R2_ACCOUNT_ID=""
# R2_BUCKET="backlot-media"
# R2_ACCESS_KEY_ID=""           # R2 API token scoped to this bucket: Object Read & Write
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT=""                # only for an EU-jurisdiction bucket: https://<account>.eu.r2.cloudflarestorage.com
# R2_PREFIX="uploads/"          # creator media
# R2_LEDGER_PREFIX="ledger/account-deletions/"   # deletion ledger; must not overlap R2_PREFIX
# R2_LEDGER_BUCKET=""           # optional separate bucket for the ledger (same credentials)
# Beta limits (docs/STORAGE.md). File-size limits are build-time (NEXT_PUBLIC): redeploy to change.
# NEXT_PUBLIC_UPLOAD_MAX_IMAGE_MB="30"
# NEXT_PUBLIC_UPLOAD_MAX_VIDEO_MB="500"
# STORAGE_QUOTA_GB="1"          # per creator, finished + in-progress
# UPLOAD_MAX_CONCURRENT="2"
# STORAGE_APP_WARN_GB="8"       # logs storage.app_usage_high above this
# STORAGE_APP_CEILING_GB="9.5"  # new uploads refused above this ("0" = no ceiling)
# UPLOAD_PART_URL_TTL_SEC="900" # signed part-upload URL lifetime
# FILE_URL_TTL_SEC="300"        # signed file-read URL lifetime
# STORAGE_DELIVERY=""           # "proxy" streams files through the app instead of signed R2 URLs
# STORAGE_ORPHAN_SWEEP=""       # "off" disables the daily orphan sweep
# STORAGE_ORPHAN_MIN_AGE_DAYS="7"
# R2 has no soft delete: leave STORAGE_SOFT_DELETE_DAYS unset (0). Legacy GCS default was 7.
# STORAGE_SOFT_DELETE_DAYS=""
# Seals upload-session references at rest (AES-256-GCM, 32 bytes base64/hex: openssl rand -base64 32).
# Optional with R2 (an R2 upload id alone grants nothing); required with legacy GCS.
# UPLOAD_SESSION_KEY=""
# Legacy Google Cloud Storage store (read-only migration support; not a production default):
# GCS_BUCKET=""
# GCS_PREFIX="uploads/"

# --- Firebase Authentication (unchanged identity system) ---
# Public client config is in firebase-applet-config.json (public by design).
# Per-environment override (build-time), e.g. a separate staging Firebase project, as one-line JSON
# with apiKey, authDomain, projectId, appId (+ messagingSenderId, storageBucket):
# NEXT_PUBLIC_FIREBASE_CONFIG=""
# FIREBASE_PROJECT_ID=""        # override the project id from that file
# Server-only Admin credential (needed on Vercel for account deletion: revoke + delete sign-in).
# Service account with only "Firebase Authentication Admin"; JSON or base64 JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# ...or the two fields:
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# Local end-to-end testing only (ignored in production builds): Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# --- Slate AI (server-side only) ---
# Primary: OpenAI. Fallback: Anthropic, used only when OpenAI is unavailable.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# OPENAI_MODEL="gpt-6.1-sol"
# ANTHROPIC_MODEL="claude-opus-5-5"
# SLATE_ENABLE_FALLBACK="true"
# SLATE_ALLOW_FALLBACK_ONLY="false"
# SLATE_ANTHROPIC_REFUSAL_FALLBACK="true"
# SLATE_SEMANTIC_SEARCH="on"
# SLATE_EMBEDDING_MODEL="text-embedding-3-small"
# SLATE_IMAGE_ANALYSIS="on"
# SLATE_DAILY_MESSAGE_LIMIT="200"

# --- Scheduled jobs (docs/WORKERS.md). Separate 32+ character secrets; unset = disabled (404). ---
# The Cloudflare Worker scheduler (ops/scheduler) sends the same values.
# DELETION_WORKER_SECRET=""     # POST /api/internal/account-deletions, every 5 minutes
# MAINTENANCE_SECRET=""         # POST /api/internal/cleanup, daily
# Optional Google Cloud Scheduler OIDC (legacy):
# INTERNAL_OIDC_AUDIENCE=""
# DELETION_WORKER_INVOKER=""
# MAINTENANCE_INVOKER=""
# Retention
# SLATE_ACTION_RETENTION_DAYS="30"
# SLATE_AUDIT_RETENTION_DAYS="180"
# ACCOUNT_DELETION_RECORD_DAYS="30"
# LEDGER_RETENTION_DAYS="90"    # must exceed backup retention + restore lead time

# --- Rollout / emergency ---
# BACKLOT_ALLOW_UNVERSIONED_WRITES_UNTIL="2026-12-01"
# BACKLOT_SKIP_CONFIG_CHECK="false"
